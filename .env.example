# 对话模型（默认 DeepSeek，OpenAI 兼容协议）
DEEPSEEK_API_KEY=sk-在这里填
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat

# 向量模型（默认硅基流动的 bge-m3，1024 维）
OPENAI_API_KEY=sk-在这里填
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# 如果没有 DEEPSEEK_API_KEY / OPENAI_API_KEY，也可以显式指定：
# CHAT_API_KEY=sk-xxx
# EMBEDDING_API_KEY=sk-yyy

# 检索参数（可选，不写就用 config/rag.yml 里的默认值）
# top_k=5
# score_threshold=0.3
